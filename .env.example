# Live quotes (api/_providers/finnhub.ts). Optional: without it, readings come from Claude's
# committed snapshot and FRED's public CSV series. Set in Vercel for Production and Preview.
FINNHUB_API_KEY=

# Password gate (middleware.ts). Set both in Vercel > Settings > Environment Variables,
# for Production and Preview. If either is missing, the site stays locked.
SITE_USERNAME=
SITE_PASSWORD=
